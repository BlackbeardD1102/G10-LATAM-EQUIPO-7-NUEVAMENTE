# --- Aplicación ---
PROJECT_NAME="G10 LATAM Equipo 7 API"
VERSION="0.1.0"
ENVIRONMENT=local          # local | development | staging | production
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- CORS (lista separada por comas) ---
