# --- Aplicación ---
PROJECT_NAME="NuevaMente API"
VERSION="0.1.0"
ENVIRONMENT=local          # local | development | staging | production
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- CORS (lista separada por comas) ---
# 3000 = `python -m http.server 3000` · 5500 = Live Server de VS Code
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=storage/uploads
